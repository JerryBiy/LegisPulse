# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI (existing)
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_LEGISCAN_API_KEY=

# Optional override for legis.ga.gov-only data (meetings/current rosters).
# Normally the browser matches the official session directory by year and
# regular/special type. If overriding, configure both IDs as a verified pair.
VITE_LEGIS_GA_LEGISCAN_SESSION_ID=
VITE_LEGIS_GA_SESSION_ID=

# ── LC-number background scan (Render server only, server.js) ──
# Required for the all-bills LC tracker to write to bill_lc_history.
# Set these in the Render service environment (NOT prefixed with VITE_;
# they are server-side secrets and must never reach the browser).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Required database scope for the LC scan. Use the LegiScan session_id only;
# do not put a legis.ga.gov sessionId here.
LEGISCAN_SESSION_ID=
# Required paired legis.ga.gov sessionId. The server verifies this against
# the provider before writing any LC history.
LEGIS_GA_SESSION_ID=
# Optional shared secret to protect POST /api/lc-recheck (recommended).
LC_RECHECK_SECRET=
# Optional scheduler interval in ms (default 3600000 = 1 hour).
LC_RECHECK_INTERVAL_MS=3600000

