# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI (existing)
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# ── LC-number background scan (Render server only, server.js) ──
# Required for the all-bills LC tracker to write to bill_lc_history.
# Set these in the Render service environment (NOT prefixed with VITE_;
# they are server-side secrets and must never reach the browser).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Optional shared secret to protect POST /api/lc-recheck (recommended).
LC_RECHECK_SECRET=
# Optional scheduler interval in ms (default 3600000 = 1 hour).
LC_RECHECK_INTERVAL_MS=3600000

